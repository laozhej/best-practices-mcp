include Makefile package.json package-lock.json .nvmrc uv.lock .tool-versions
include .github/release-please-config.json .github/.release-please-manifest.json
recursive-include docs *.md *.html *.json
recursive-include examples *.py *.json
recursive-include scripts *.py *.html
recursive-include tests *.py *.json *.rb *.mjs *.html
recursive-include vendor/badgeapp *
recursive-include vendor/badgeapp-m3 *
recursive-include src/best_practices_mcp/data *.json *.txt *.md
prune docs/live-qa
